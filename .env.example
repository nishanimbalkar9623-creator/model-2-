# ============ AOS AI ENGINE CONFIGURATION ============
# All values can be overridden by environment variables.
# Copy to .env and adjust as needed.

# ---- Service ----
SERVICE_NAME=AOS-AI-Engine
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# ---- LLM Provider selection ----
# pick one: mock | openai | gemini | anthropic | ollama | openrouter
#   mock        = offline, deterministic (used for tests / local dev, no keys needed)
#   openrouter  = production LLM provider (see "OpenRouter" section below)
LLM_PROVIDER=mock
# provider-specific keys/models (only use what your provider needs)
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434

# ============================
# AOS LLM — OpenRouter
# ============================
# Set LLM_PROVIDER=openrouter to use OpenRouter. See README "OpenRouter setup".
# base URL (leave default unless you use a proxy)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# default model used for most tasks
OPENROUTER_MODEL=openai/gpt-4o-mini
# optional routing slots (leave blank to fall back to OPENROUTER_MODEL)
OPENROUTER_FAST_MODEL=
OPENROUTER_REASONING_MODEL=
# optional attribution headers (used by OpenRouter for rankings)
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=AOS
# timeouts / client tuning
OPENROUTER_CONNECT_TIMEOUT_SECONDS=10.0
OPENROUTER_READ_TIMEOUT_SECONDS=120.0
OPENROUTER_REQUEST_ID_HEADER=X-Request-Id

# ============================
# OPENROUTER KEY POOL
# ============================
# Provide one or more keys. Only as many as you configure are used; all five
# are NOT required. Never commit real keys to Git.
OPENROUTER_API_KEY_1=PASTE_OPENROUTER_KEY_HERE
OPENROUTER_API_KEY_2=PASTE_OPENROUTER_KEY_HERE
OPENROUTER_API_KEY_3=PASTE_OPENROUTER_KEY_HERE
OPENROUTER_API_KEY_4=PASTE_OPENROUTER_KEY_HERE
OPENROUTER_API_KEY_5=PASTE_OPENROUTER_KEY_HERE
# Maximum attempts for one LLM request (never exceeds number of keys)
MAX_LLM_RETRIES=3
# Temporary key cooldown after a transient failure
OPENROUTER_KEY_COOLDOWN_SECONDS=60

# ---- Backend integration ----
BACKEND_BASE_URL=http://localhost:8000
BACKEND_API_KEY=
# alternative to API key: JWT token
BACKEND_JWT_TOKEN=
BACKEND_TIMEOUT_SECONDS=15.0
BACKEND_MAX_RETRIES=2

# ---- Auth for THIS engine ----
ENGINE_API_KEY=
ENGINE_JWT_SECRET=

# ---- Memory ----
MEMORY_TTL_SECONDS=3600
MEMORY_MAX_MESSAGES=50

# ---- RAG ----
RAG_VECTOR_STORE=in_memory   # in_memory | chroma | faiss
RAG_EMBEDDING_PROVIDER=mock  # mock | sentence-transformers
RAG_EMBEDDING_MODEL=
RAG_TOP_K=5

# ---- Speech-to-text ----
STT_PROVIDER=mock            # mock | openai | gemini | whisper-local
STT_MODEL=
STT_API_KEY=
STT_MAX_AUDIO_BYTES=10485760

# ---- Safety ----
REQUIRE_CONFIRMATION_DEFAULT=true
MAX_REQUEST_CHARS=8000
MAX_TOOLS_PER_TURN=20